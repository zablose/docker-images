ZDI_ENV=dev
ZDI_TIMEZONE=Europe/London
ZDI_USER_GROUP_ID=1000
ZDI_USER_GROUP_NAME=debian
ZDI_USER_ID=1000
ZDI_USER_NAME=debian

ZDI_DIR_WEB=/home/web
ZDI_DIR_WEB_APP=/home/web/app
ZDI_DIR_WEB_APP_ROOT=/home/web/app/public
ZDI_WEB_DOMAIN=allog.zdi

ZDI_ADD_COMPOSER=true
ZDI_ADD_LARAVEL=false
ZDI_VERSION_COMPOSER=2.8.7
ZDI_VERSION_PHP=8.4

ZDI_DB_NAME=allog
ZDI_DB_PASSWORD=password
ZDI_DB_USERNAME=allog

ZDI_HOST_IP=127.0.0.10



ALLOG_DEBUG=false

ALLOG_SERVER_NAME=allog

ALLOG_DB_CONNECTION=mysql
ALLOG_DB_HOST=allog-mariadb
ALLOG_DB_PORT=3306
ALLOG_DB_DATABASE=${ZDI_DB_NAME}
ALLOG_DB_USERNAME=${ZDI_DB_USERNAME}
ALLOG_DB_PASSWORD=${ZDI_DB_PASSWORD}
ALLOG_DB_PREFIX=

ALLOG_CLIENT_1_NAME=kanboard
ALLOG_CLIENT_1_TOKEN=0000111A000011110001
ALLOG_CLIENT_1_IP=127.0.0.1

ALLOG_CLIENT_2_NAME=app2
ALLOG_CLIENT_2_TOKEN=0000111A000011110002
ALLOG_CLIENT_2_IP=127.0.0.1
