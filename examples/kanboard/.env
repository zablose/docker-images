ZDI_ENV=dev
ZDI_TIMEZONE=Europe/London
ZDI_USER_GROUP_ID=1000
ZDI_USER_GROUP_NAME=debian
ZDI_USER_ID=1000
ZDI_USER_NAME=debian

ZDI_DIR_WEB=/home/web
ZDI_DIR_WEB_APP=/home/web
ZDI_DIR_WEB_APP_ROOT=/home/web
ZDI_WEB_DOMAIN=kanboard.zdi

ZDI_ADD_COMPOSER=true
ZDI_ADD_LARAVEL=true
ZDI_VERSION_ALLOG=2.2.0
ZDI_VERSION_COMPOSER=2.7.9
ZDI_VERSION_KANBOARD=1.2.44
